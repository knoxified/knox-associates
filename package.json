{
  "name": "knox-associates",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing website for Knox & Associates: Next.js static export served by a Cloudflare Worker.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "next build && wrangler dev",
    "deploy": "next build && wrangler deploy",
    "lint": "eslint .",
    "test": "node --test worker/validate.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.553.0",
    "next": "^15.5.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "postcss": "^8.5.6",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3",
    "wrangler": "^4"
  }
}
